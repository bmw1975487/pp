class EngineError(RuntimeError):
    def __init__(self, code: str, message: str, *, stage: str,
                 slide: Optional[int] = None, role: Optional[str] = None,
                 detail: Optional[Dict[str, Any]] = None):
        super().__init__(message)
        self.code = code
        self.stage = stage
        self.slide = slide
        self.role = role
        self.detail = detail or {}


class JsonlLogger:
    def __init__(self, path: Path):
        self.path = path
        path.parent.mkdir(parents=True, exist_ok=True)
        self._fh = path.open("w", encoding="utf-8")

    def event(self, stage: str, status: str, message: str, **extra: Any) -> None:
        row: Dict[str, Any] = {
            "ts": datetime.now(timezone.utc).isoformat(),
            "engine": ENGINE_ID,
            "engineVersion": ENGINE_VERSION,
            "fallback": "DISABLED",
            "fallbackUsed": False,
            "stage": stage,
            "status": status,
            "message": message,
        }
        row.update({k: v for k, v in extra.items() if v is not None})
        self._fh.write(json.dumps(row, ensure_ascii=False) + "\n")
        self._fh.flush()

    def close(self) -> None:
        try:
            self._fh.close()
        except Exception:
            pass


@dataclass
class ImageSlot:
    placeholder_idx: int
    x_emu: int
    y_emu: int
    width_emu: int
    height_emu: int
    width_in: float
    height_in: float
    exact_ratio: float
    requested_ratio: str
    prompt: str = ""
    path: str = ""


@dataclass
class SlideSpec:
    role: str
    title: str = ""
    subtitle: str = ""
    lead: str = ""
    body: str = ""
    section: str = ""
    number: str = ""
    points: List[Dict[str, str]] = field(default_factory=list)
    contents: List[Dict[str, str]] = field(default_factory=list)
    image_slots: List[ImageSlot] = field(default_factory=list)


def _progress(callback: Any, percent: int, stage: str, message: str) -> None:
    try:
        callback.onProgress(int(percent), str(stage), str(message))
    except Exception:
        pass


def _clean(value: Any, maximum: int) -> str:
    return re.sub(r"\s+", " ", str(value or "")).strip()[:maximum].rstrip()


def _body(value: Any, maximum: int = 1050) -> str:
    text = str(value or "").replace("\r", "").strip()
    paras = [re.sub(r"\s+", " ", x).strip() for x in text.split("\n") if x.strip()]
    if len(paras) <= 1:
        sentences = [x.strip() for x in re.split(r"(?<=[.!?])\s+", " ".join(paras)) if x.strip()]
        if len(sentences) >= 4:
            step = max(1, math.ceil(len(sentences) / 3))
            paras = [" ".join(sentences[i:i + step]) for i in range(0, len(sentences), step)]
    return "\n\n".join(paras[:3])[:maximum].rstrip()


def _points(raw: Any, body: str) -> List[Dict[str, str]]:
    out: List[Dict[str, str]] = []
    if isinstance(raw, list):
        for item in raw[:4]:
            if isinstance(item, dict):
                out.append({
                    "title": _clean(item.get("title"), 42),
                    "body": _clean(item.get("body"), 150),
                })
    sentences = [x.strip() for x in re.split(r"(?<=[.!?])\s+", body.replace("\n", " ")) if x.strip()]
    fallback_titles = ["Контекст", "Механизм", "Эффект", "Контроль"]
    while len(out) < 4:
        pos = len(out)
        out.append({
            "title": fallback_titles[pos],
            "body": _clean(sentences[pos] if pos < len(sentences) else "Практический элемент решения", 150),
        })
    return out[:4]


def _read_response(response: Any, maximum: int) -> bytes:
    chunks: List[bytes] = []
    total = 0
    while True:
        part = response.read(64 * 1024)
        if not part:
            break
        total += len(part)
        if total > maximum:
            raise EngineError("V3_HTTP_RESPONSE_TOO_LARGE",
                              f"Ответ сервиса превышает {maximum} байт", stage="NETWORK")
        chunks.append(part)
    return b"".join(chunks)


def _post_json(endpoint: str, payload: Dict[str, Any], key: str,
               timeout: int, maximum: int) -> Dict[str, Any]:
    request = urllib.request.Request(
        endpoint,
        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        method="POST",
        headers={
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json; charset=utf-8",
            "Accept": "application/json",
            "Accept-Encoding": "identity",
            "User-Agent": "Neon-V3-Android/1.1",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = _read_response(response, maximum)
    except urllib.error.HTTPError as error:
        try:
            detail = _read_response(error, 1024 * 1024).decode("utf-8", "replace")[:1600]
        except Exception:
            detail = ""
        raise EngineError("V3_HTTP_ERROR", f"RouterAI HTTP {error.code}: {detail}",
                          stage="NETWORK", detail={"endpoint": endpoint, "httpStatus": error.code}) from error
    except Exception as error:
        raise EngineError("V3_NETWORK_FAILED", f"Ошибка RouterAI: {error}",
                          stage="NETWORK", detail={"endpoint": endpoint}) from error
    try:
        return json.loads(raw.decode("utf-8"))
    except Exception as error:
        raise EngineError("V3_HTTP_JSON_INVALID", "Ответ RouterAI не является JSON",
                          stage="NETWORK") from error


def _download_image(url: str) -> bytes:
    if not url.startswith("https://"):
        raise EngineError("V3_IMAGE_URL_INVALID", "Небезопасный URL изображения",
                          stage="IMAGE_GENERATE")
    try:
        request = urllib.request.Request(url, headers={
            "Accept-Encoding": "identity", "User-Agent": "Neon-V3-Android/1.1"})
        with urllib.request.urlopen(request, timeout=180) as response:
            return _read_response(response, 40 * 1024 * 1024)
    except EngineError:
        raise
    except Exception as error:
        raise EngineError("V3_IMAGE_DOWNLOAD_FAILED", f"Не удалось скачать изображение: {error}",
                          stage="IMAGE_GENERATE") from error


def _extract_json(text: str) -> Dict[str, Any]:
    source = (text or "").strip()
    source = re.sub(r"^```(?:json)?\s*", "", source, flags=re.I)
    source = re.sub(r"\s*```$", "", source)
    first, last = source.find("{"), source.rfind("}")
    if first < 0 or last <= first:
